# Groq API Key (primary LLM - fast & free tier: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Fallback LLMs, used automatically when Groq is rate limited or errors (both optional)
GEMINI_API_KEY=your_gemini_api_key_here    # https://aistudio.google.com/apikey
NVIDIA_API_KEY=your_nvidia_api_key_here    # https://build.nvidia.com
# Optional model overrides (defaults: openai/gpt-oss-120b, gemini-3.5-flash-lite, openai/gpt-oss-20b)
# GROQ_MODEL=
# GEMINI_MODEL=
# NVIDIA_MODEL=

# Google Search (for web search tool)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here
